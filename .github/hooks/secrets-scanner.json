{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell",
        "bash": "node ./.github/hooks/scripts/scan-commit-secrets.js",
        "powershell": "node ./.github/hooks/scripts/scan-commit-secrets.js",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}