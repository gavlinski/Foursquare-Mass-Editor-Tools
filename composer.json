{
    "name": "eliotools/foursquare-editor",
    "description": "Foursquare Mass Editor Tools",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "monolog/monolog": "^3.0",
        "vlucas/phpdotenv": "^5.5",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "ElioTools\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.0"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests"
    },
    "config": {
        "sort-packages": true
    }
}
