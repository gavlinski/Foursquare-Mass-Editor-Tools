<?php
/**
 * Credenciais sensíveis do Google Maps - ARQUIVO EXEMPLO
 * 
 * Este arquivo lê as credenciais do Google Maps a partir de variáveis de ambiente,
 * seguindo o padrão usado em app_credentials.php.
 * 
 * Em produção, as variáveis são injetadas via GitHub Secrets no arquivo .env
 * Em desenvolvimento, podem ser definidas no .env local
 * 
 * Como obter as credenciais:
 * - API Key: https://console.cloud.google.com/apis/credentials
 * - Map ID: https://console.cloud.google.com/google/maps-apis/maps-management/maps
 */

return [
    // Google Maps API Key - Lê da variável de ambiente GOOGLE_MAPS_API_KEY
    'google_maps_api_key' => getenv('GOOGLE_MAPS_API_KEY') ?: 'YOUR_GOOGLE_MAPS_API_KEY',
    
    // Google Maps Map ID - Lê da variável de ambiente GOOGLE_MAPS_MAP_ID
    'google_maps_map_id' => getenv('GOOGLE_MAPS_MAP_ID') ?: 'YOUR_GOOGLE_MAPS_MAP_ID',
];
