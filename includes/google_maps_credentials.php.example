<?php
/**
 * Credenciais sensíveis do Google Maps - ARQUIVO EXEMPLO
 * 
 * Este arquivo lê as credenciais do Google Maps a partir de variáveis de ambiente.
 * 
 * IMPORTANTE: Este arquivo contém informações sensíveis e deve ser mantido seguro.
 * Não faça commit dessas informações em repositórios públicos.
 * 
 * Em produção, as variáveis são injetadas via GitHub Secrets no arquivo .env
 * Em desenvolvimento, podem ser definidas no .env local
 * 
 * Como obter as credenciais:
 * - API Key: https://console.cloud.google.com/apis/credentials
 * - Map ID: https://console.cloud.google.com/google/maps-apis/maps-management/maps
 */

// Carrega variáveis de ambiente do arquivo .env
if (file_exists(__DIR__ . '/../.env')) {
    $envFile = __DIR__ . '/../.env';
    $lines = file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    
    foreach ($lines as $line) {
        // Ignora comentários
        if (strpos(trim($line), '#') === 0) {
            continue;
        }
        
        // Parse linha no formato KEY=VALUE
        if (strpos($line, '=') !== false) {
            list($key, $value) = explode('=', $line, 2);
            $key = trim($key);
            $value = trim($value);
            
            // Remove aspas se existirem
            $value = trim($value, '"\'');
            
            // Define variável de ambiente se ainda não existe
            if (!getenv($key)) {
                putenv("$key=$value");
            }
        }
    }
}

return [
    // Google Maps API Key (JavaScript) - Obtenha sua chave em: https://console.cloud.google.com/google/maps-apis/credentials
    // Restrição: HTTP referrers (domínios permitidos)
    // Uso: Mapas no navegador (JavaScript)
    'google_maps_api_key' => getenv('GOOGLE_MAPS_API_KEY') ?: 'YOUR_GOOGLE_MAPS_API_KEY',
    
    // Google Maps Geocoding API Key (Server-side) - OPCIONAL
    // Restrição: Endereços IP (IP do servidor)
    // Uso: Geocodificação server-side (PHP)
    // Cota gratuita: 10.000 requisições/mês ($5 por 1.000 adicional)
    // Configure em: https://console.cloud.google.com/google/maps-apis/credentials
    'google_maps_geocoding_key' => getenv('GOOGLE_MAPS_GEOCODING_KEY') ?: null,
    
    // Google Maps Map ID - Configure seu Map ID em: https://console.cloud.google.com/google/maps-apis/studio/maps
    'google_maps_map_id' => getenv('GOOGLE_MAPS_MAP_ID') ?: 'YOUR_GOOGLE_MAPS_MAP_ID',
];
