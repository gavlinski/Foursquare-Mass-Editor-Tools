# Foursquare API Credentials
FOURSQUARE_CLIENT_KEY=your_client_key
FOURSQUARE_CLIENT_SECRET=your_client_secret

# Foursquare OAuth Redirect URI
# Desenvolvimento: https://localhost/4sqmet/index.php
# Produção: https://4sq.eliotools.site/index.php
FOURSQUARE_REDIRECT_URI=https://localhost/4sqmet/index.php

# Google Maps Credentials
# API Key JavaScript (com restrição de HTTP referrers)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_MAP_ID=your_google_maps_map_id

# API Key Server-Side para Geocoding (OPCIONAL)
# Requer restrição de IP (não HTTP referrers)
# Cota gratuita: 10.000 requisições/mês
# Crie em: https://console.cloud.google.com/google/maps-apis/credentials
# GOOGLE_MAPS_GEOCODING_KEY=your_geocoding_server_key

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Dojo Toolkit Source (apenas em desenvolvimento)
# local = Usa arquivos locais (js/dojo/, js/dijit/, js/dojox/) - Requer ./dev.sh dojo
# cdn = Usa Google CDN (padrão, não requer download)
# Produção SEMPRE usa CDN (ignora este valor)
DOJO_SOURCE=cdn

# Application URL
# Desenvolvimento: https://localhost/4sqmet
# Produção: https://4sq.eliotools.site
APP_URL=https://localhost/4sqmet

# Session Configuration
SESSION_LIFETIME=1440
SESSION_SECURE=true
SESSION_HTTPONLY=true

# Cookie Settings
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Lax
