# Foursquare API Credentials
# Para desenvolvimento local, use suas próprias credenciais
FOURSQUARE_CLIENT_KEY=seu_client_key_aqui
FOURSQUARE_CLIENT_SECRET=seu_client_secret_aqui
FOURSQUARE_REDIRECT_URI=http://localhost/4sqmet/index.php

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/4sqmet

# Para produção, use:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=http://4sq.eliotools.site
# FOURSQUARE_REDIRECT_URI=http://4sq.eliotools.site/index.php

# Session Configuration
SESSION_LIFETIME=1440
SESSION_SECURE=false
SESSION_HTTPONLY=true

# Cookie Settings (em produção, definir SECURE=true)
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Strict
