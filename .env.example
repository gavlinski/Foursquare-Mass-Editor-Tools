# Foursquare API Credentials
FOURSQUARE_CLIENT_KEY=your_client_key
FOURSQUARE_CLIENT_SECRET=your_client_secret

# Foursquare OAuth Redirect URI
# Desenvolvimento: https://localhost/4sqmet/index.php
# Produção: https://4sq.eliotools.site/index.php
FOURSQUARE_REDIRECT_URI=https://localhost/4sqmet/index.php

# Google Maps Credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_MAP_ID=your_google_maps_map_id

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Application URL
# Desenvolvimento: https://localhost/4sqmet
# Produção: https://4sq.eliotools.site
APP_URL=https://localhost/4sqmet

# Session Configuration
SESSION_LIFETIME=1440
SESSION_SECURE=true
SESSION_HTTPONLY=true

# Cookie Settings
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Strict
